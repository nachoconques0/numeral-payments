{
  "info": {
    "name": "Numeral Payments",
    "description": "Numeral Payments - every request against the running service.\n\nRequests are numbered in the order they are meant to run: 02 creates the payment that 04 replays and 05 conflicts with. Running the whole collection top to bottom is green.\n\nAuth is set on the collection (Basic, {{username}}/{{password}}); 06 and 07 override it deliberately. Set {{baseUrl}} if the service is not on localhost:8080.\n\nRe-running 02 returns the stored payment rather than creating a new one - that is the idempotency key working, not a stale response. Use 03 for a fresh payment each time.\n\nThe payment stays PENDING until the bank answers: run `make fakebank` in another terminal, or `cp resources/bank_response.csv $BANK_FOLDER/`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "CALCAGNO",
      "type": "string"
    },
    {
      "key": "password",
      "value": "xxxx",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "JXJ984XXXZ",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Proves the service is up and that /health needs no credentials.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Create payment (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "The provided request_sample.json body. Proves the happy path: 200, a row stored as PENDING, and payment_<id>.xml written to BANK_FOLDER with MsgId set to the idempotency key.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 Create payment, random key (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Same payment under a freshly generated key, so it can be fired repeatedly during a demo and create a new payment every time.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{randomKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh 10-character key, so this request can be fired repeatedly in a demo.",
              "const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';",
              "let key = '';",
              "for (let i = 0; i < 10; i++) {",
              "    key += alphabet.charAt(Math.floor(Math.random() * alphabet.length));",
              "}",
              "pm.collectionVariables.set('randomKey', key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 Replay, same key and payload (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Identical to Create payment. Proves a genuine retry returns the payment already stored, with no second row and no second bank file.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 Conflict, same key different payload (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Same key, different creditor and amount. Proves the key is checked rather than trusted: 409 instead of silently returning someone else's payment. Requires Create payment to have run.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248599\",\n    \"creditor_name\": \"someone else\",\n    \"ammount\": 5000.0,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 No credentials (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Overrides the collection auth with noauth. Proves an unauthenticated request is rejected with 401 and never reaches the service.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 Wrong credentials (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Correct user, wrong password. Proves credentials are actually checked.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "not-the-password",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 Malformed JSON (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "A body that is not JSON at all. Proves a parse failure is a clean 400, not a 500.",
        "body": {
          "mode": "raw",
          "raw": "{\"debtor_iban\": \"FR1112739000504482744411A64\",",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 Schema violation (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "An unknown extra property and a debtor_iban that fails the schema pattern. Proves validation runs against the provided schema and the violations come back in details.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"not-an-iban\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\",\n    \"surprise\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10 Too many decimals (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "42.999 cannot be stored exactly in cents. Proves it is refused rather than quietly rounded to 43.00.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 42.999,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "11 Exponent notation (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "4.299e1 is a valid JSON number but not a form this service accepts.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 4.299e1,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 Amount too large to store (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "An amount that overflows int64 cents. Proves the decimal parser refuses what it cannot store exactly rather than wrapping.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"debtor_iban\": \"FR1112739000504482744411A64\",\n    \"debtor_name\": \"company1\",\n    \"creditor_iban\": \"DE65500105179799248552\",\n    \"creditor_name\": \"beneficiary\",\n    \"ammount\": 92233720368547758.99,\n    \"idempotency_unique_key\": \"{{idempotencyKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "13 Method not allowed (405)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Proves a known path with an unsupported method is a 405, not a 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 405\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
